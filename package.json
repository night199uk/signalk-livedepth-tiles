{
  "name": "signalk-livedepth-tiles",
  "version": "0.2.1",
  "description": "Shared gridded bathymetry tile algorithm (Web-Mercator XYZ quadtree, sparse codec, min-pool) for the LiveDepth server plugin and chart client.",
  "keywords": [
    "bathymetry",
    "depth",
    "tiles",
    "signal-k",
    "live-depth"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -w",
    "prepack": "npm run build",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "oxlint src test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "oxlint": "^1.74.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
